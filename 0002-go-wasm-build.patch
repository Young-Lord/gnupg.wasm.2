+
+wasm_info() {
+  printf '[wasm] %s\n' "$*"
+}
+
+wasm_die() {
+  printf '[wasm] error: %s\n' "$*" >&2
+  return 1 2>/dev/null || exit 1
+}
+
+wasm_append_flags() {
+  local current="$1"
+  local extra="$2"
+
+  if [[ -n "$current" ]]; then
+    printf '%s %s' "$current" "$extra"
+  else
+    printf '%s' "$extra"
+  fi
+}
+
+if [[ ! -f "$GNUPG_WASM_EMSDK/emsdk_env.sh" ]]; then
+  wasm_die "Missing emsdk_env.sh at $GNUPG_WASM_EMSDK/emsdk_env.sh"
