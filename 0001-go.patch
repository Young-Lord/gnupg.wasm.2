+      mark('launcher-loaded');
+      return;
+    }
+    if (step === 'run.preRun.fs-init') {
+      mark('prerun-fs-init');
+      return;
+    }
+    if (step === 'run.runtime-initialized') {
+      mark('runtime-ready');
+      return;
+    }
+    if (step === 'client.pinentry.request') {
+      mark('pinentry-request');
+      return;
+    }
+    if (step === 'client.pinentry.reply') {
+      mark('pinentry-reply');
+      return;
