+#!/usr/bin/env bash
+
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+STAGE_DIR="$ROOT_DIR/PLAY/iwa-stage"
+OUT_DIR="$ROOT_DIR/PLAY/iwa"
+KEY_DIR="$ROOT_DIR/PLAY/iwa-keys"
+
